# --- Runtime ---
NODE_ENV=production
PORT=3001

# --- CORS ---
# Frontend origin(s), separated by comma. Use * only за dev.
CORS_ORIGIN=https://astro-os.com

# --- Encryption ---
# 32-character secret used by utils/encryption.js for encrypting the
# Anthropic API key stored in the SQLite settings table.
ENCRYPTION_KEY=replace-with-32-character-secret-

# --- Anthropic (optional fallback) ---
# Normally the API key is added through the app Settings UI and stored
# encrypted in the DB. Set this only if you want to bootstrap on first run
# without going through the UI.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Database (optional) ---
# Override default SQLite path (~/.astro-os/astro.db) if needed.
# DB_PATH=/var/data/astro.db
